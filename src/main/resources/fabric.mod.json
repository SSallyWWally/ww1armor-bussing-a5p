  "authors": [
    "You"
  ],
  "license": "All-Rights-Reserved",
  "icon": "assets/exodus/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.exodusvehicles.ArmoredCarMod"
    ],
    "client": [
      "com.exodusvehicles.client.ArmoredCarClient"
    ]
  },
  "mixins": [
    "exodus.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "tacz": "*"
  }
}